{
  "manifest_version": 3,
  "name": "Just Focus",
  "version": "1.0.0",
  "description": "Block distracting sites on a timer, and hide the feeds on the ones you keep.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.reddit.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.linkedin.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "rules.js",
        "declutter.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
